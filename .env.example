# Application
APP_ENV=development
LOG_LEVEL=INFO
AUTH_MODE=single_user_dev
DEV_PRINCIPAL_ID=local-development-user

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MAX_UPLOAD_SIZE_BYTES=52428800
STORAGE_DIR=D:\projects\DataPilot\storage
MAX_DATASET_ROWS=1000000
MAX_DATASET_COLUMNS=1000
MAX_PREVIEW_ROWS=100

# Database (used from Phase 2 onward)
DATABASE_URL=

# LLM provider (used from Phase 7 onward)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
